FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# ---------- Dependency layer (cached until requirements change) ----------
# The UI only needs streamlit + httpx — it talks to the Atlas API over HTTP
# and never imports anything from the atlas backend package. Installing the
# full backend here (docling, onnxruntime, PyMuPDF, OpenCV, etc.) would add
# hundreds of MB and minutes of build time for zero benefit.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir "streamlit>=1.31" "httpx>=0.27" "PyYAML>=6.0"

# ---------- Source layer (rebuilds only on UI code changes — fast) ----------
COPY ui ./ui

EXPOSE 8501

CMD ["streamlit", "run", "ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
