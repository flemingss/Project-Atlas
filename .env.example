# ---- Core ----
ATLAS_ENV=dev
ATLAS_LOG_LEVEL=INFO

# Docker build: optional Python extras to include in the Atlas API image.
# Docling is a required base dependency; set this only for additional extras.
ATLAS_PIP_EXTRAS=

# Minimal RC auth for /admin endpoints.
# In dev, leaving this blank keeps admin endpoints open.
# In non-dev, Atlas should refuse to start unless this is set to a non-default secret.
ATLAS_ADMIN_TOKEN=

# Atlas HTTP server
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8080

# Artifact store (local filesystem)
ATLAS_ARTIFACTS_DIR=./artifacts

# ---- LLM Profile ----
# Which posture the pipeline runs in. See config/models.yaml 'profiles'.
#
#   api    generation on OpenRouter under enforced zero-data-retention.
#          Large context, holistic refinement, long read timeouts.
#   local  generation on LM Studio or any LAN OpenAI-compatible server.
#          Small context, sectional refinement.
#
# This switches model ids AND the tuning that has to move with them (context
# budget, section size, judge budget). Embeddings are NOT affected — they run
# in the compose stack and stay pinned across profiles, so ingest and search
# never depend on LM Studio being up.
ATLAS_LLM_PROFILE=api

# ---- LLM Providers ----
# OpenRouter gateway. Required by the 'api' profile.
# Zero-data-retention is asserted per request (provider.zdr=true) in addition
# to whatever your account policy enforces — see models.yaml providers.openrouter.
OPENROUTER_API_KEY=

# Embedding sidecar. Runs on CPU in the compose stack; no API key.
# Override only if you run the sidecar somewhere else.
ATLAS_EMBEDDINGS_BASE_URL=http://embeddings:80

# Local OpenAI-compatible endpoint (LM Studio). Only the 'local' profile needs this.
# NOTE: keep /v1 out; Atlas will normalize it.
# If running Atlas directly on your host (no containers):
# ATLAS_OPENAI_BASE_URL=http://127.0.0.1:1234
# If running Atlas inside Docker and LM Studio on your host:
ATLAS_OPENAI_BASE_URL=http://host.docker.internal:1234

# E2E (local_llm mode): model names must match a model actually loaded in your
# OpenAI-compatible server, or the preflight warns and the chat check fails.
# Note the nine E2E scenarios themselves run on deterministic stubs and need
# no models at all — this only affects `--mode local_llm`.
ATLAS_E2E_LLM_MODEL=qwen3-14b
ATLAS_E2E_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Optional: print OpenAI-compatible request traces from Atlas.
ATLAS_OPENAI_TRACE=

# Default model roles (resolved through config/models.yaml + DB overrides)
ATLAS_DEFAULT_TENANT_ID=local
ATLAS_DEFAULT_PROJECT_ID=default

# Frontier providers (optional, unused by the shipped profiles).
# Note: the direct OpenAI API does not carry a zero-data-retention guarantee
# without an enterprise arrangement — prefer routing through OpenRouter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Databases ----
# Postgres (Docker) — host port; the container listens on 5432
ATLAS_DB_URL=postgresql+psycopg://atlas:atlas@localhost:15432/atlas

# Qdrant (Docker) — host port; the container listens on 6333
ATLAS_QDRANT_URL=http://localhost:17333

# ---- Dify (runs via docker compose) ----
# IMPORTANT: change these for any non-throwaway environment.
DIFY_SECRET_KEY=sk-change-me
DIFY_INIT_PASSWORD=
DIFY_REDIS_PASSWORD=difyai123456

# These control how Dify UI talks to the Dify API from your browser.
DIFY_CONSOLE_WEB_URL=http://localhost
DIFY_CONSOLE_API_URL=http://localhost:5001
DIFY_APP_WEB_URL=http://localhost
DIFY_APP_API_URL=http://localhost:5001

# Optional (only if you use Dify plugin features)
DIFY_PLUGIN_DAEMON_KEY=change-me
DIFY_PLUGIN_DIFY_INNER_API_KEY=change-me
