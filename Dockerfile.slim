# ════════════════════════════════════════════════════════════════════════════════
# Dockerfile.slim — Lightweight API container for VLM-only ingestion
# ════════════════════════════════════════════════════════════════════════════════
#
# USE CASE:
#   When using VLM (Vision Language Model) for all document ingestion, with LLMs
#   served externally (gRPC, LM Studio, OpenAI). This variant removes Docling and
#   all heavy ML dependencies to reduce build size from ~13.8GB to ~1.5-2GB.
#
# WHAT'S REMOVED & WHY:
#   ✗ docling         — PDF parsing with layout/OCR analysis. Only needed for
#                       Docling ingest path. VLM path renders PDFs server-side.
#   ✗ onnxruntime     — ML inference runtime (docling dependency). ~5GB.
#   ✗ torch, pytorch  — Deep learning frameworks (docling transitive). ~3GB.
#   ✗ layout models   — Auto-downloaded OCR/detection models. ~2GB.
#   ✗ opencv*         — Computer vision library (docling OCR).
#   ✗ transformers    — Hugging Face models (docling dependency).
#
# WHAT'S KEPT:
#   ✓ FastAPI, Uvicorn       — Web framework
#   ✓ SQLAlchemy, Psycopg    — Database ORM & driver
#   ✓ Qdrant client          — Vector store
#   ✓ httpx                  — HTTP client for external services
#   ✓ pydantic               — Data validation
#   ✓ PyMuPDF                — Lightweight PDF metadata/text extraction
#   ✓ pdfplumber             — PDF table extraction
#   ✓ All pipeline nodes     — Judge, Refine, Cleanup, Chunking
#   ✓ VLM ingest (page rendering via external VLM service)
#   ✓ RAG endpoints          — Search, retrieval, QA
#
# TRADE-OFFS:
#   ✗ Cannot use Docling ingest method (falls back to VLM required)
#   ✗ No automatic layout analysis — rely on VLM for formatting
#   ✓ 7x smaller image
#   ✓ Faster pulls, faster restarts
#   ✓ Lower memory footprint (~2GB vs ~6GB RAM at runtime)
#
# WHEN TO USE THE FULL DOCKERFILE:
#   - Multi-method ingestion (both Docling and VLM)
#   - PDF layout analysis required (tables, figures, reading order)
#   - No external VLM — using embedded vision models
#   - E2E testing with all pathways
#
# ════════════════════════════════════════════════════════════════════════════════

# ── Stage 1: Build React UI ──
FROM node:20-slim AS ui-build
WORKDIR /ui
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ .
RUN npm run build
# Output lands in /ui/../static/app → /static/app

# ── Stage 2: Python runtime (slim) ──
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# ---------- OS libraries (minimal — removed opencv/ML deps) ----------
# Only keeping what we actually use without Docling:
#   - libpq: postgresql client lib
# Removed: libgl1, libglib2.0-0, libx11-6, libxcb1, libsm6, libxext6, libxrender1
#          (all for OpenCV/X11, not needed without layout analysis)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

# ---------- Dependency layer (slim version) ----------
# Override pyproject.toml to exclude docling before pip install
COPY pyproject.toml LICENSE README.md ./
RUN mkdir -p src/atlas && echo '__version__ = "0.0.0"' > src/atlas/__init__.py \
    && pip install --no-cache-dir --upgrade pip

RUN pip install --no-cache-dir \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.27" \
    "pydantic>=2.6" \
    "pydantic-settings>=2.2" \
    "pyyaml>=6.0.1" \
    "httpx>=0.27" \
    "python-multipart>=0.0.12" \
    "sqlalchemy>=2.0" \
    "psycopg[binary]>=3.1" \
    "qdrant-client>=1.9.0" \
    "PyMuPDF>=1.24.0" \
    "pdfplumber>=0.10" \
    "pyclipper>=1.3" \
    "shapely>=2.0" \
    "scikit-learn>=1.4" \
    "huggingface-hub>=0.20"

# ---------- Source layer (rebuilds only on code changes) ----------
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

# Runtime assets
COPY config ./config
RUN cp -n config/pipeline.yaml.example config/pipeline.yaml 2>/dev/null || true \
 && cp -n config/models.yaml.example config/models.yaml 2>/dev/null || true
COPY scripts ./scripts
COPY static ./static
# Overlay the React SPA build output
COPY --from=ui-build /static/app ./static/app

EXPOSE 8080

CMD ["python", "-m", "atlas"]
