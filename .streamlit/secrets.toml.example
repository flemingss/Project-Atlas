# Local Streamlit secrets (copy to `.streamlit/secrets.toml`).
# This file is intentionally safe to commit; the real secrets file is gitignored.

# Admin token used by the Operator Console to call /admin/* endpoints.
ATLAS_ADMIN_TOKEN = "atlas-dev-admin"

# Optional: if you run the API on a non-default port.
# ATLAS_API_URL = "http://127.0.0.1:18080"
