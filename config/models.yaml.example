version: 1

providers:
  lmstudio:
    type: openai_compat
    base_url_env: ATLAS_OPENAI_BASE_URL

  deterministic:
    type: deterministic

  openai_frontier:
    type: openai
    api_key_env: OPENAI_API_KEY

  anthropic_frontier:
    type: anthropic
    api_key_env: ANTHROPIC_API_KEY

roles:
  judge_model:
    provider: lmstudio
    model_name: "qwen3-14b"
    params:
      temperature: 0.0
      max_tokens: 500

  refine_model:
    provider: lmstudio
    model_name: "qwen3-8b"
    params:
      temperature: 0.2

  embed_model:
    provider: lmstudio
    model_name: "text-embedding-nomic-embed-text-v1.5"
    params: {}

  metadata_tier1_model:
    provider: lmstudio
    model_name: "qwen3-14b"
    params:
      temperature: 0.0
      max_tokens: 1000

  metadata_tier2_model:
    provider: lmstudio
    model_name: "qwen3-14b"
    params:
      temperature: 0.0
      max_tokens: 1000

  reranker_model:
    provider: lmstudio
    model_name: "bge-reranker"
    params: {}
