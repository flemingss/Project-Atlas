version: 1

thresholds:
  judge_cutoff_refine: 4
  # Per-dimension judge floors (optional). If any dimension falls below its
  # floor the document is sent to refine regardless of composite score.
  # Set to 0 to disable per-dimension gating for a given dimension.
  judge_dim_floors:
    faithfulness: 3
    formatting: 2
    cohesion: 2
    hallucination_risk: 3
  # Composite score at or below which the document is immediately FAILED
  # (skipping refine entirely).  Set to 0 to disable.
  fail_fast_score: 0
  # Minimum ratio of refined output length to input length.  If the LLM
  # refine step produces text shorter than input × this ratio, the
  # refinement is rejected and the original text is kept.
  refine_min_preservation_ratio: 0.85
  # Minimum ratio of markdown heading count in refine output vs input.
  # If the refined text has fewer than this fraction of the original's
  # headings, refinement is rejected as sections_dropped.
  refine_min_section_ratio: 0.8
  # When true, a document whose formatting sub-score is below cutoff but
  # whose content dimensions are above cutoff is re-routed through CLEANUP
  # instead of REFINE.
  cleanup_rejudge: true

limits:
  refine_max_retries: 3
  # Cap on tier-2 metadata escalations per document. Currently has no
  # effect: metadata is generated once per document, so the counter this
  # is compared against is always 0. Kept for when metadata becomes
  # per-chunk. See atlas/pipeline/metadata.py _select_tier.
  tier2_chunk_cap_per_document: 25
  # Back-compat: older configs used chunk_max_chars. Kept as a safety valve.
  chunk_max_chars: 1000
  # Context-window budget (tokens) for a single holistic refine pass.
  #
  # This is only half the check.  Refine emits a full rewrite, so the response
  # is about as long as the input, and the refine model's response ceiling
  # (models.yaml roles.refine_model.max_output_tokens) usually binds first — a
  # model with a 1M context may cap responses at 48k.  Both are enforced in
  # atlas.pipeline.tokens.fits_in_context; documents exceeding either take the
  # sectional path.  Profile-driven — see models.yaml profiles.
  max_context_tokens: 16384
  # Maximum section size (tokens) for sectional refinement.  Sections
  # larger than this are sent individually; smaller sections may be batched.
  # Size this to the refine model: 6000 suits a local 8B, a large-context
  # hosted model can take far bigger sections and stitch better for it.
  refine_max_section_tokens: 6000
  # Context budget for the judge, which embeds the entire document in its
  # prompt with no truncation.  Documents above this skip quality grading
  # rather than failing ingest with an over-length request — they are still
  # chunked, embedded and searchable, just not graded or refined.
  # 0 or unset disables the guard (pre-existing behaviour: fail on oversize).
  # Profile-driven — see models.yaml profiles.
  judge_max_context_tokens: 32000

normalize:
  enabled: true

chunking:
  # semantic: heading/table/list aware (recommended)
  # paragraph: legacy paragraph splitter (max_chars)
  strategy: semantic
  target_tokens: 320
  max_tokens: 400
  qa:
    min_chunk_count: 1
    max_token_ratio_limit: 1.25
    max_duplication_ratio: 0.10
    min_coverage_ratio: 0.80

retry:
  llm:
    max_retries: 3
    base_delay_s: 2.0
    max_delay_s: 30.0
  vectorstore:
    max_retries: 3
    base_delay_s: 1.0
    max_delay_s: 15.0
  docling:
    max_retries: 2
    base_delay_s: 3.0
    max_delay_s: 30.0

# ---------------------------------------------------------------------------
# Builtin extraction-artifact cleanup (toggles, all ON by default)
# ---------------------------------------------------------------------------
# These run automatically during the Cleanup node BEFORE user-defined rules.
# They fix common PDF/HTML-to-markdown extraction artefacts that are always
# safe to repair.  Set any toggle to false to disable it.
builtin_cleanup:
  html_unescape: true        # Decode HTML entities (&amp; → &, &#8212; → —)
  fix_ligatures: true         # Decompose ligatures (ﬁ → fi, ﬂ → fl)
  strip_zero_width_chars: true  # Remove zero-width/invisible Unicode chars
  strip_page_numbers: true    # Remove standalone page-number lines (Page 3, 2/10, etc.)
  strip_bullet_glyphs: true      # "- • text" → "- text"; also drops PDF symbol-font glyphs (U+E000–F8FF)
  normalize_superscripts: true   # "1×10 -7" → "1×10^-7", "1 st" → "1st"
  dedupe_table_spans: true       # Blank repeats of a merged cell Docling copies into every spanned column
  # table_span_min_chars: 20     # Body-row floor: shorter repeats ("off | off", "Included | Included")
                                 # are real data and stay. Header rows are deduplicated at any length.
  strip_repetitive_lines: false  # Remove short lines repeating ≥ threshold times (OFF by default)
  # repetitive_line_threshold: 8   # Min occurrences to consider a line repetitive
  # repetitive_line_max_chars: 80  # Only lines ≤ this length are candidates
  strip_repeated_headings: false # Drop later copies of a heading seen ≥ threshold times — per-page
                                 # running headers. OFF: a manual repeating "## Notes" would lose them.
  # repeated_heading_threshold: 3

# ---------------------------------------------------------------------------
# Config-driven cleanup rules (Phase 7A)
# ---------------------------------------------------------------------------
# Rules are evaluated in declaration order; the FIRST matching rule is applied
# (no merging in v1).  An empty "match" block is a catch-all.
#
# Supported step kinds:
#   strip_lines_matching, rewrite_pattern, strip_headers_footers,
#   normalize_headings, fix_numbered_headings, merge_hardwrapped_paragraphs,
#   fix_bullets, html_unescape
#
# cleanup_rules:
#   - name: pdf_scanned_defaults
#     match:
#       mime_type: application/pdf
#     steps:
#       - kind: merge_hardwrapped_paragraphs
#       - kind: normalize_headings
#       - kind: fix_bullets
#     tags:
#       - auto_fix_only
#
#   - name: strip_legal_headers
#     match:
#       corpus_id: legal_docs
#     steps:
#       - kind: strip_headers_footers
#         first_n: 3
#         last_n: 2
#         patterns:
#           - "^Page \\d+ of \\d+$"
#           - "^CONFIDENTIAL"
#     tags:
#       - auto_fix_only
#
#   - name: catch_all
#     match: {}
#     steps:
#       - kind: normalize_headings
#       - kind: fix_bullets
cleanup_rules: []

# ---------------------------------------------------------------------------
# Layout PDF parser configuration
# ---------------------------------------------------------------------------
# Controls how PDFs are parsed during ingest.  The layout parser uses ONNX
# models (auto-downloaded from HuggingFace) for page-layout detection, OCR,
# and table structure recognition.
#
# pdf_parser:
#   # Backend selection: auto | auto_layout | layout | docling
#   # auto (default): try Docling first, fall back to layout parser on failure.
#   # auto_layout: try layout parser first, fall back to Docling on failure.
#   backend: auto
#   # Zoom factor for page rendering (higher = better OCR at cost of speed/RAM).
#   # Applies to the layout parser only.
#   zoom: 3.0
#   # Minimum mean OCR confidence to accept layout parser output (0.0 - 1.0).
#   # Applies to the layout parser only.
#   ocr_confidence_min: 0.5
#   # Table structure recognition (Docling's TableFormer).
#   #   true  — tables become real markdown tables with separate rows/columns.
#   #   false — roughly 6x faster, but a table collapses onto a single line,
#   #           which makes citing an individual cell impossible.
#   # Leave this on for spec sheets and parameter tables. Turning it off is
#   # only worthwhile for prose-heavy documents with no meaningful tables.
#   # Note: TableFormer normalises cell text (it rewrites "1E-11" as "1e-11"),
#   # so table content is not reproduced byte-for-byte.
#   table_extraction: true
